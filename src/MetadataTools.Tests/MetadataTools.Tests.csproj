<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <StartupObject>AutoGeneratedProgram</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="Microsoft.DiaSymReader" Version="2.0.0" />
    <PackageReference Include="xunit" Version="2.8.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BinaryCompatChecker\BinaryCompatChecker.csproj" />
    <ProjectReference Include="..\PETree\PETree.csproj" />
    <Compile Include="..\RefDump\Program.cs" Link="RefDump\Program.cs" />
    <Compile Include="..\PEFile\CryptoBlobParser.cs" Link="PEFile\CryptoBlobParser.cs" />
    <Compile Include="..\PEFile\Corflags.cs" Link="PEFile\Corflags.cs" />
    <Compile Include="..\lbi\TextUtilities.cs" Link="lbi\TextUtilities.cs" />
    <Compile Include="..\DumpModules\ReadVirtualStream.cs" Link="DumpModules\ReadVirtualStream.cs" />
    <Compile Include="..\Pdb\*.cs" Link="Pdb\%(Filename)%(Extension)" />
    <Compile Include="..\SRMReader\Program.cs" Link="SRMReader\Program.cs" />
    <Reference Include="Mono.Cecil">
      <HintPath>..\..\lib\Mono.Cecil.dll</HintPath>
    </Reference>
  </ItemGroup>

</Project>
