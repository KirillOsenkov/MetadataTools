<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RollForward>major</RollForward>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <PropertyGroup>
    <Version>1.0.0</Version>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>FindUnusedMembers</ToolCommandName>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <PackageId>FindUnusedMembers</PackageId>
    <Authors>Kirill Osenkov</Authors>
    <Description>Lists types and members of an assembly that are not reachable from a set of consumer assemblies. Reads IL, metadata and compiled XAML (BAML).</Description>
    <PackageTags>.NET dotnet assembly unused dead code members types trim cleanup metadata baml xaml</PackageTags>
    <PackageReadmeFile>readme.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/KirillOsenkov/MetadataTools</PackageProjectUrl>
    <RepositoryUrl>https://github.com/KirillOsenkov/MetadataTools</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Mono.Cecil" Version="0.11.5" />
    <PackageReference Include="BamlParser" Version="1.0.1" />
  </ItemGroup>

  <ItemGroup>
    <None Include="readme.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\PEFile\PEFile.cs" Link="PEFile.cs" />
  </ItemGroup>

</Project>
